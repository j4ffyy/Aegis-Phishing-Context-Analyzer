# Aegis Backend — Environment Variables Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control (.gitignore already excludes it).
#
# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────
#
# Controls CORS enforcement strictness and logging verbosity.
# Values: "development" (default) | "production"
#
#   development — CORS wildcard ("*") is used. All origins are accepted.
#                 Safe for local testing; never use in public deployment.
#
#   production  — CORS is locked to CORS_ORIGIN (required). If CORS_ORIGIN
#                 is not set, the server will refuse to start with a
#                 RuntimeError to prevent accidental open CORS in prod.
#
ENVIRONMENT=development


# ─────────────────────────────────────────────────────────────────────────────
# CORS ORIGIN LOCKDOWN (PR-07)
# ─────────────────────────────────────────────────────────────────────────────
#
# The exact Chrome Extension origin to allow cross-origin requests from.
# Required when ENVIRONMENT=production.
#
# How to find your extension ID:
#   1. Open Chrome → chrome://extensions
#   2. Enable "Developer mode" (top-right toggle)
#   3. Load the Aegis extension (Load unpacked → select aegis-extension/)
#   4. Copy the 32-character ID displayed under the extension name
#   5. Set: CORS_ORIGIN=chrome-extension://<your-32-char-id>
#
# On Render.com:
#   Dashboard → aegis-backend service → Environment → Add Environment Variable
#   Key: CORS_ORIGIN
#   Value: chrome-extension://abcdefghijklmnopqrstuvwxyz123456
#
# NOTE: Starlette CORSMiddleware does NOT support glob patterns.
#       "chrome-extension://*" will NOT work — use the full literal ID.
#
CORS_ORIGIN=chrome-extension://YOUR_EXTENSION_ID_HERE


# ─────────────────────────────────────────────────────────────────────────────
# VIRUSTOTAL API
# ─────────────────────────────────────────────────────────────────────────────
#
# VirusTotal free-tier API key for URL & hash reputation queries.
# Register at https://www.virustotal.com/gui/join-us
# Free tier: 4 requests/minute, 500/day.
#
VT_API_KEY=your_virustotal_api_key_here


# ─────────────────────────────────────────────────────────────────────────────
# RENDER.COM DEPLOYMENT REFERENCE
# ─────────────────────────────────────────────────────────────────────────────
#
# Production backend URL (already added to manifest.json host_permissions):
#   https://aegis-backend.onrender.com
#
# Render.com environment variables to set before deploying:
#   ENVIRONMENT=production
#   CORS_ORIGIN=chrome-extension://<your-extension-id>
#   VT_API_KEY=<your-virustotal-api-key>
#
