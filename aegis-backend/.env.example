# Aegis Backend — Environment Variables Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# VirusTotal free-tier API key.
# Register at https://www.virustotal.com/gui/join-us
VT_API_KEY=your_virustotal_api_key_here

# Chrome Extension origin for production CORS lock (Week 5 deploy).
# Get this from chrome://extensions after loading the unpacked extension.
# Format: chrome-extension://<32-character-extension-id>
# Example: chrome-extension://abcdefghijklmnopqrstuvwxyz123456
CORS_ORIGIN=chrome-extension://YOUR_EXTENSION_ID_HERE

# Deployment environment: "development" | "production"
# Controls logging verbosity and CORS enforcement strictness.
ENVIRONMENT=development
